<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10/11 and is patched by Windows Update -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>StreamDirector</AssemblyName>
    <RootNamespace>StreamDirector</RootNamespace>
    <Product>StreamDirector</Product>
    <Company>StreamDirector</Company>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Single-file app: everything the exe needs is embedded, StreamDirector.exe is the whole release.
    Resource names mirror paths; the renderer is served from wwwroot/*, see EmbeddedFiles.cs.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\index.html;..\app.js;..\player.js;..\audio-relay.js;..\audio-tap.js;..\styles.css" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\vendor\hls.light.mjs" LogicalName="wwwroot/vendor/hls.light.mjs" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="licenses/LICENSE" />
    <EmbeddedResource Include="..\vendor\hls.js.LICENSE" LogicalName="licenses/hls.js.LICENSE" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll;$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="assemblies/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="native/win-x64/WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" LogicalName="native/win-x86/WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" LogicalName="native/win-arm64/WebView2Loader.dll" />
  </ItemGroup>

</Project>
